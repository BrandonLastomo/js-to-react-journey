<%- include('layouts/header') -%> <%- include('layouts/nav') -%>
<div class="container mt-5">
  <div class="card" style="width: 18rem">
    <div class="card-body">
      <h5 class="card-title"><%= detail.name %></h5>
      <h6 class="card-subtitle mb-2 text-body-secondary">
        <%= detail.phone %>
      </h6>
      <a href="/data/update/<%= detail.name %>" class="btn btn-warning badge"
        >Edit</a
      >
      <!-- <a
        href="/data/delete/<%= detail.name %>"
        class="btn btn-danger badge"
        onclick="confirm('Are you sure?')"
        >Delete</a
      > -->
      <form action="/data?_method=DELETE" method="post" class="d-inline-block">
        <input type="hidden" name="name" value="<%= detail.name %>" />
        <button
          type="submit"
          class="btn btn-danger badge"
          onclick="confirm('You sure?')"
        >
          Delete
        </button>
      </form>
      <a href="/" class="card-link d-block mt-3">Back to Home</a>
    </div>
  </div>
</div>
<%- include('layouts/footer') -%>
