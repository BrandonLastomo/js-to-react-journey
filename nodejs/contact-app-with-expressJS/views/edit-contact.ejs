<%- include('layouts/header') %>
<%- include('layouts/nav') %>
<div class="container mt-3">
    <div class="col-md-6">
        <h3>Edit Contact</h3>
        <% if(typeof errors != 'undefined') { %>
            <div class="alert alert-danger" role="alert">
                <ul>
                    <% errors.forEach((error)=>{ %>
                        <li><%= error.msg %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>
        <form action="/data/update" method="post">
          <input type="hidden" name="oldPhone" value="<%= contact.phone %>">
          <div class="form-group mb-3">
            <label for="name">Name</label>
            <input type="name" class="form-control" name="name" id="name" placeholder="Enter your name" autofocus value="<%= contact.name %>">
          </div>
          <div class="form-group mb-3">
            <label for="phone">Phone Number</label>
            <input type="text" class="form-control" name="phone" id="phone" placeholder="Enter your phone number"  value="<%= contact.phone %>">
          </div>
          <div class="form-group mb-3">
            <label for="email">Email</label>
            <input type="email" class="form-control" name="email" id="email" placeholder="Enter your email"  value="<%= contact.email %>">
          </div>
          <button type="submit" class="btn btn-primary">Edit</button>
        </form>
    </div>
</div>
<%- include('layouts/footer') %>